{
    "name": "contatoseguro/teste-backend",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "robmorgan/phinx": "^0.16.6",
        "symfony/yaml": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Contatoseguro\\TesteBackend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContatoSeguro\\Tests\\": "tests/"
        }
    },
    "scripts":{
        "migrate": "./vendor/bin/phinx migrate",
        "create-migration": "./vendor/bin/phinx create",
        "rollback-migration": "./vendor/bin/phinx rollback",

        "test": ["phpunit --testdox"],
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.11",
        "phpstan/phpstan": "^2.2"
    }
}
