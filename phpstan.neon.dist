parameters:
    level: 5
    paths:
        - src
        - tests
        - db/migrations
    excludePaths:
        - db/migrations/templates
    ignoreErrors:
        # O Slim resolve [Controller::class, 'metodo'] instanciando o controller,
        # mas o PHPStan exige um callable estático nas rotas.
        -
            identifier: argument.type
            path: src/Config/routes.php
