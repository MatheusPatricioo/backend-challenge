<?xml version="1.0"?>
<ruleset name="TesteBackend">
    <description>Padrão de código do projeto: PSR-12.</description>

    <file>src</file>
    <file>tests</file>
    <file>db/migrations</file>
    <exclude-pattern>db/migrations/templates/*</exclude-pattern>

    <config name="ignore_warnings_on_exit" value="1"/>

    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>db/migrations/*</exclude-pattern>
    </rule>
</ruleset>